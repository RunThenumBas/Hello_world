# Intuit Developer app credentials (see docs/QBO_CASH_FLOW_INTEGRATION.md section 1)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox        # sandbox | production
QBO_REDIRECT_URI=http://localhost:3000/callback

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/qbo_cashflow

# 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Express session secret (used only to hold the OAuth state/CSRF token during /connect -> /callback)
SESSION_SECRET=

PORT=3000

# Set true to enable the optional days-to-pay adjustment in the projection algorithm
# once payment_history has been populated for at least one full sync cycle.
USE_DAYS_TO_PAY_ADJUSTMENT=false

# Default payment term (days) used when an invoice/bill has no due date at all.
DEFAULT_PAYMENT_TERM_DAYS=30
